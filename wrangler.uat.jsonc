{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opjc",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "opjc-auth",
      "database_id": "fc783431-28e0-44ac-8d6e-aaff06de6fbe"
    },
    {
      "binding": "APP_DB",
      "database_name": "opjc-uat",
      "database_id": "282c0590-905e-4261-a1b7-690ebe5e79b1"
    }
  ],
  "main": "src/worker.js",
  "keep_vars": true,
  "secrets_store_secrets": [
    {
      "binding": "BOOTSTRAP_TOKEN",
      "store_id": "039b10a326f040ae9c5412575c07b048",
      "secret_name": "BOOTSTRAP_TOKEN"
    }
  ]
}
