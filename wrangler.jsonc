{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opjc",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      ".github/**",
      "README.md",
      "wrangler*.jsonc",
      "schema/**",
      "src/**"
    ],
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "opjc-auth",
      "database_id": "fc783431-28e0-44ac-8d6e-aaff06de6fbe"
    },
    {
      "binding": "APP_DB",
      "database_name": "opjc-prod",
      "database_id": "ef7103a7-c0cd-419c-8ed2-061cba6d18fc"
    }
  ],
  "main": "src/worker.js",
  "keep_vars": true
}
